# Copy to .env (git-ignored) and adjust. Placeholders only — never commit real secrets.
APP_ENV=development                 # production enables hard guards (see README → Security)
DATABASE_URL=sqlite:///backend/var/aptiguard.db   # or postgresql+psycopg://USER:PASSWORD@HOST/aptiguard
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true                      # false in production (startup refuses otherwise)
DEMO_PASSWORD=change-me-for-shared-demos   # password given to the seeded synthetic demo accounts
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=300
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=12
# Optional LLM variant generation — off by default; deterministic templates always work offline
LLM_PROVIDER=none                   # none | anthropic  (then: pip install -r backend/requirements-llm.txt)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
