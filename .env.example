# Copy to .env and adjust. Placeholders only — never commit real secrets.
APP_ENV=development
DATABASE_URL=sqlite:///backend/var/aptiguard.db   # or postgresql+psycopg://user:pass@localhost/aptiguard
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
MAX_UPLOAD_MB=10
# Optional LLM variant generation (off by default; deterministic templates always work)
LLM_PROVIDER=none          # none | anthropic  (requires: pip install -r backend/requirements-llm.txt)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
