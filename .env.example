# Copy to .env (git-ignored) and adjust. Placeholders only — never commit real secrets.
APP_ENV=development                 # development | test | production (production enables hard guards)
DATABASE_URL=sqlite:///backend/var/aptiguard.db   # or postgresql+psycopg://USER:PASSWORD@HOST:5432/aptiguard
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true                      # must be false in production (startup refuses otherwise)
DEMO_PASSWORD=change-me-for-shared-demos   # password given to the seeded synthetic demo accounts
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=300
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=12
# Docker only
DEMO_SEED=false                     # true: seed synthetic demo data into an EMPTY database at container start
FORWARDED_ALLOW_IPS=127.0.0.1       # proxies trusted for X-Forwarded-For (set by the compose file)
# Optional LLM variant generation — off by default; deterministic templates always work offline
LLM_PROVIDER=none                   # none | anthropic  (then: pip install -r backend/requirements-llm.txt)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
